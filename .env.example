# TomCat configuration. Copy to .env and point the systemd unit at it.
# Values shown are the code defaults; uncomment and change only what you need.
# Names and meanings match the Python original, so an existing .env carries over.

# --- PIR input (BCM numbering), catdeter only ---
#TOMCAT_PIR_GPIO=17

# --- Hardware PWM channel ---
# The output pin is fixed by the device-tree overlay, not here.
# dtoverlay=pwm-2chan maps PWM0 to GPIO18 (physical pin 12) and PWM1 to GPIO19.
#TOMCAT_PWM_CHIP=0
#TOMCAT_PWM_CHANNEL=0

# --- Ultrasonic drive ---
#TOMCAT_F_LOW_HZ=20000
#TOMCAT_F_HIGH_HZ=24000
#TOMCAT_SWEEP_STEP=250
#TOMCAT_SWEEP_TICK_S=0.020

# Duty cycle, 0..1000000. 500000 = 50 %, which is the loudest a square wave
# gets; past half it grows quieter again. 250000 is about 6 dB down.
#TOMCAT_DUTY=500000

# --- Burst behaviour (seconds), catdeter only ---
#TOMCAT_BURST_SECONDS=4.0
#TOMCAT_COOLDOWN_S=8.0

# --- Quiet hours (24h clock), catdeter only ---
# Window wraps past midnight. start == end disables it.
#TOMCAT_QUIET_START_H=22
#TOMCAT_QUIET_END_H=7

# --- Event log location ---
#TOMCAT_DB_PATH=/home/pi/catdeter.sqlite3
